---
import HomeLayout from "../layouts/HomeLayout.astro";
import SiteHeader from "../components/home/SiteHeader.astro";
import ActionLink from "../components/home/ActionLink.astro";
import SectionHeading from "../components/home/SectionHeading.astro";
import Strengths from "../components/home/Strengths.astro";
import FeaturedWork from "../components/home/FeaturedWork.astro";
import MoreWorkList from "../components/home/MoreWorkList.astro";
import Career from "../components/home/Career.astro";
import HowILead from "../components/home/HowILead.astro";
import Contact from "../components/home/Contact.astro";

const mhUrl = "https://www.modernhealth.com/";
const anomalieUrl =
  "https://www.retaildive.com/news/davids-bridal-acquires-custom-wedding-dress-startup-anomalie/623973/";
const sfUrl = "https://www.stitchfix.com/";
const modClothUrl = "http://www.modcloth.com";
const builtUrl = "http://www.getBuilt.com";
const tiveUrl = "http://www.tive.com";

const resumeUrl = "https://docs.google.com/document/d/1SaZ4JSDOMKmL3DXPAOlfW2wrOcPJz3YNPabrS91beSI/preview";
const linkedinUrl = "https://www.linkedin.com/in/borudesign/";
const mediumUrl = "https://medium.com/@yorthehunter";
---

<HomeLayout title="Brian Cleveland | Player-Coach Design Leader">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader resumeUrl={resumeUrl} />
  <main id="main">
    <section class="hero">
      <div class="band-content">
        <div class="hero-content">
          <h1 class="hero-title display">
            <span class="line line-light">I Lead <span class="accent">Design</span></span>
            <span class="line line-accent">and stay <span class="ink">hands-on</span></span>
          </h1>
          <p class="mono eyebrow">Player-coach design leader · 16 years in product design</p>
        </div>
        <p class="intro">
          Design Lead and Manager at <a href={tiveUrl} target="_blank" rel="noopener noreferrer">Tive</a>.
          Previously at <a href={sfUrl} target="_blank" rel="noopener noreferrer">Stitch Fix</a>,
          <a href={mhUrl} target="_blank" rel="noopener noreferrer">Modern Health</a>,
          <a href={builtUrl} target="_blank" rel="noopener noreferrer">Built Technologies</a>,
          <a href={anomalieUrl} target="_blank" rel="noopener noreferrer">Anomalie</a>, and
          <a href={modClothUrl} target="_blank" rel="noopener noreferrer">ModCloth</a>.
        </p>
        <ul class="hero-links">
          <li><ActionLink href="#my-work" label="My Work" variant="filled" /></li>
          <li><ActionLink href={resumeUrl} label="My Resume" external /></li>
          <li><ActionLink href={linkedinUrl} label="LinkedIn" external /></li>
          <li><ActionLink href={mediumUrl} label="Medium" external /></li>
        </ul>
      </div>
    </section>

    <Strengths />

    <section class="band" id="my-work">
      <div class="band-content">
        <SectionHeading
          title="Work"
          description="examples of the product and systems work that shaped how I lead today"
        />
        <FeaturedWork />
        <MoreWorkList />
      </div>
    </section>

    <Career />
    <HowILead />
    <Contact resumeUrl={resumeUrl} linkedinUrl={linkedinUrl} mediumUrl={mediumUrl} />
  </main>
</HomeLayout>

<style>
  /* Wipes the headline in left to right behind a soft-edged mask whose edge
     position is animated, easing out so it slows near the end. The element
     keeps its full size throughout, so nothing below it shifts. */
  @property --wipe {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 115%;
  }

  .hero-title {
    --wipe-mask: linear-gradient(
      90deg,
      #000 calc(var(--wipe) - 15%),
      transparent var(--wipe)
    );
    -webkit-mask-image: var(--wipe-mask);
    mask-image: var(--wipe-mask);
    /* The mask only paints inside the box; pad it and pull it back with a
       matching negative margin so descenders aren't clipped and the layout
       is unchanged. */
    padding-block: 0.2em;
    margin-block: -0.2em;
    animation: headline-wipe 2.5s cubic-bezier(0.4, 0.05, 0.355, 1) 0.25s both;
  }

  @keyframes headline-wipe {
    from {
      --wipe: 0%;
    }
    to {
      --wipe: 115%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      -webkit-mask-image: none;
      mask-image: none;
      animation: none;
    }
  }

  /* The header's bottom rule already separates the hero from the page. */
  .hero {
    border-top: 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--fs-display);
  }

  /* Each line is a block that hugs its words, and wraps with them. */
  .line {
    display: block;
    padding-inline: var(--space-sm);
  }

  .line-light {
    background: var(--bg);
    color: var(--fg);
  }

  .line-light .accent {
    color: var(--accent-text);
  }

  .line-accent {
    background: var(--accent);
    color: var(--on-accent);
  }

  .line-accent .ink {
    color: var(--color-dark-gray);
  }

  /* Mobile reads eyebrow first, then headline. Desktop puts it underneath. */
  .eyebrow {
    order: -1;
    margin-bottom: var(--space-sm);
  }

  .intro {
    max-width: 61rem;
  }

  .intro a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .intro a:hover {
    text-decoration-thickness: 3px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (min-width: 54rem) {
    .eyebrow {
      order: 0;
      margin-bottom: 0;
    }

    .hero-links :global(.action-link.filled) {
      background: transparent;
      color: var(--fg);
    }

    .hero-links :global(.action-link.filled:hover) {
      background: var(--fg);
      color: var(--bg);
    }
  }
</style>
