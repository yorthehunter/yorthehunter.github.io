---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import HomeLayout from "../../layouts/HomeLayout.astro";
import SiteHeader from "../../components/home/SiteHeader.astro";
import { resumeUrl } from "../../data/site-links";
import CaseStudyFigure from "../../components/CaseStudyFigure.astro";
import ActionLink from "../../components/home/ActionLink.astro";

import boardImg from "../../assets/images/tive-design-board.png";
import reviewPrepImg from "../../assets/images/tive-review-prep.png";
import riskAnalysisImg from "../../assets/images/tive-risk-analysis.png";
import tablesPlanImg from "../../assets/images/tive-tables-plan.png";
import tablesBeforeImg from "../../assets/images/tive-tables-before.png";
import tablesAfterImg from "../../assets/images/tive-tables-after.png";
import bannersAuditImg from "../../assets/images/tive-banners-audit.png";
import bannersLibraryImg from "../../assets/images/tive-banners-library.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sections = [
  { id: "challenge", label: "Challenge" },
  { id: "team", label: "Team" },
  { id: "manager", label: "Manager" },
  { id: "judgment", label: "Judgment" },
  { id: "proof", label: "Proof" },
  { id: "people", label: "People" },
  { id: "learned", label: "Learned" },
];
---

<CaseStudyLayout
  title="Scaling Design Judgment · Brian Cleveland"
  description="How I increased ownership across a senior design team at Tive with a lightweight operating model, AI-assisted review prep, and risk-based validation."
  navLabel="Leadership at Tive Case Study"
  variant="new"
  shell={HomeLayout}
  sections={sections}
>
  <Fragment slot="header">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader resumeUrl={resumeUrl} />
  </Fragment>

  <!-- HERO -->
  <header class="content-section">
    <p class="eyebrow all-caps soft">Design leadership at Tive • 3rd Quarter 2026</p>
    <h1 class="heading-1">Scaling design judgment, not just design output</h1>
    <p class="cs-lede">
      Evolving a senior product design team from reactive execution toward an autonomous, strategic function.
    </p>
    <ul class="cs-stats">
      <li><span class="value">3 platforms</span><span class="label">Design leadership across web, mobile, and hardware</span></li>
      <li><span class="value">4</span><span class="label">Key product areas</span></li>
      <li><span class="value">Player-coach</span><span class="label">Management + hands-on systems work</span></li>
      <li><span class="value word">1 hr → 10 min</span><span class="label">Prep time per design review, self-timed</span></li>
    </ul>
    <dl class="cs-facts rows">
      <div>
        <dt>My role</dt>
        <dd>Product Design Lead and Manager (player-coach), partnering with product managers, engineering managers, and the leadership team.</dd>
      </div>
      <div>
        <dt>Context</dt>
        <dd>Tive is a Series C supply chain visibility platform spanning web, native mobile, and connected hardware. Engineering was growing quickly and adopting AI.</dd>
      </div>
    </dl>
  </header>

  <!-- THE LEADERSHIP CHALLENGE -->
  <section class="content-section" id="challenge">
    <p class="eyebrow all-caps soft">The leadership challenge</p>
    <h2 class="heading-3">&ldquo;We're waiting on design.&rdquo;<br />No, you're waiting on design <em class="cs-accent">mocks</em>.</h2>
    <div class="cs-prose">
      <p>That feedback got louder as engineering grew and adopted AI to speed through code. We were launching faster with less design confidence, and the team was stretched thin <b>trying to do it all</b>.</p>
      <p>Engineers had come to expect a high-fidelity Figma mock for every flow and edge case, so our time went to tactical work. The goal wasn't to add process or become a decision gatekeeper. It was <i>enough</i> structure and context for designers to work <b>independently</b> while raising the <b>quality and consistency</b> of the work.</p>
    </div>
    <p class="cs-callout">The question became: <em>how do I scale design judgment without becoming the bottleneck?</em></p>
  </section>

  <!-- 01 TEAM -->
  <section class="content-section" id="team">
    <div class="cs-decision-head">
      <span class="index" aria-hidden="true">01</span>
      <div>
        <p class="eyebrow all-caps soft">Scale the team</p>
        <h2 class="heading-3">Autonomy requires <i>visibility</i>, not more <i>approval gates</i>.</h2>
      </div>
    </div>
    <div class="cs-move">
      <div class="cs-prose">
        <p>Designers were spending long hours on mocks when what we needed was <b>bigger, systemic changes</b>.</p>
        <p>I introduced Design Triage: a weekly space to align on shared work and pull design system and architectural big rocks in alongside feature work. Design Jam brings PMs in earlier, and a Slack channel turns anyone&rsquo;s idea into a ticket.</p>
      </div>
      <CaseStudyFigure
        src={boardImg}
        alt="The design team's board with six columns: Needs Triage with 97 cards, Want to Do with 20, Designing with 21, In Review or Blocked with 12, Design Done with 10, and Building with 4. Cards include Banner audit, Design migration template, Table Migration, Card Migration, and Button component micro interactions, most tagged Design System or Design Ops."
        caption="The design team&rsquo;s board, live: design system and design ops work sits next to feature work, moving from Needs Triage through Designing and Design Done to Building."
      />
      <aside class="cs-outcome">
        <p class="eyebrow all-caps">Result</p>
        <p>Designers now drive bigger architectural changes in support of the roadmap, and I can see the decisions where my involvement has the most impact.</p>
      </aside>
    </div>
  </section>

  <!-- 02 MANAGER -->
  <section class="content-section" id="manager">
    <div class="cs-decision-head">
      <span class="index" aria-hidden="true">02</span>
      <div>
        <p class="eyebrow all-caps soft">Scale the manager</p>
        <h2 class="heading-3">AI helped me spend less time reconstructing context and more time challenging the work.</h2>
      </div>
    </div>
    <div class="cs-move">
      <div class="cs-prose">
        <p>Managing senior designers across <i>many</i> simultaneous initiatives meant gathering a lot of context before every review.</p>
        <p>So I built a review-prep workflow in Claude. Give it a project name and it gathers recent context from Slack, Google Drive, and Figma, structured around the questions I need answered before a critique.</p>
        <p>I stop asking designers to replay every decision, and critique goes to strategy instead of pixel-level feedback.</p>
      </div>
      <CaseStudyFigure
        src={reviewPrepImg}
        alt="Excerpt from an AI-generated design review prep brief: a Biggest unanswered questions section listing open decisions about scope, architecture, edge cases, carried-over scope, and QA ownership."
        caption="From a review-prep brief: the open questions worth challenging, gathered before the critique starts."
      />
      <aside class="cs-outcome">
        <p class="eyebrow all-caps">Result</p>
        <p>By my own timing, prep dropped from about an hour to about ten minutes across roughly 20 reviews. AI didn&rsquo;t replace design judgment. It created more room for it.</p>
      </aside>
    </div>
  </section>

  <!-- 03 JUDGMENT -->
  <section class="content-section" id="judgment">
    <div class="cs-decision-head">
      <span class="index" aria-hidden="true">03</span>
      <div>
        <p class="eyebrow all-caps soft">Scale judgment</p>
        <h2 class="heading-3">Not every design problem deserves the same process.</h2>
      </div>
    </div>
    <div class="cs-move even">
      <div class="cs-prose">
        <p>We rate each decision by <b>impact and uncertainty</b>, then pick a validation method to match, from heuristic review and analytics to interviews and usability testing. Risk calls get talked through in Design Triage.</p>
      </div>
      <div class="cs-panel">
        <div class="cs-matrix" role="table" aria-label="Validation by impact and uncertainty">
          <div class="ax" role="columnheader"></div>
          <div class="ax col" role="columnheader">Low uncertainty</div>
          <div class="ax col" role="columnheader">High uncertainty</div>
          <div class="ax" role="rowheader">Low impact</div>
          <div class="cell c1" role="cell"><small>Evidence: light</small><b>Ship + observe</b></div>
          <div class="cell c2" role="cell"><small>Evidence: some</small><b>Some lightweight validation</b></div>
          <div class="ax" role="rowheader">High impact</div>
          <div class="cell c3" role="cell"><small>Evidence: focused</small><b>Focused, targeted validation</b></div>
          <div class="cell c4" role="cell"><small>Evidence: deep</small><b>Deep research + deeper validation</b></div>
        </div>
      </div>
      <CaseStudyFigure
        src={riskAnalysisImg}
        alt="A risk analysis document for a ticket about a misleading tracker warning. A summary table breaks the work into four milestones: define when the warning fires, pick the pattern, rewrite the copy, and add a way to suppress the warning. Each has a risk level of low or medium and a validation method, such as analytics review, heuristic review, a usability check, or customer conversations. Below the table, each milestone explains its risk and states a confidence level."
        caption="A first pass from Claude, run against our risk framework: each milestone in a ticket gets a risk level, a confidence, and a validation method to match."
      />
      <aside class="cs-outcome">
        <p class="eyebrow all-caps">Result</p>
        <p>App architecture decisions are now made strategically rather than by hunch. More roadmap features ship on their scheduled date, and launches are higher quality.</p>
      </aside>
    </div>
  </section>

  <!-- CASE IN POINT: THE MIGRATION PROCESS (TABLES PILOT + BANNERS) -->
  <section class="content-section" id="proof">
    <p class="eyebrow all-caps soft">Case in point</p>
    <h2 class="heading-3">No one owned the rollout, so <i>design took on the plan</i>.</h2>
    <div class="cs-prose">
      <p>Design system changes would get designed, and often built once, but the app-wide rollout took a very long time. Sometimes it never finished. No one owned the migration.</p>
      <p>I proposed that design take on more of the planning: communicate intent better, partner with product to get the work onto teams&rsquo; boards, and partner with engineering and QA to keep the plan realistic. Another designer and I shaped that into a migration process and pitched it to our head of product.</p>
      <p>The process has one test: <b>whoever owns the work can create tickets from the plan without coming back to design with questions.</b></p>
    </div>

    <div class="cs-run">
      <p class="eyebrow all-caps soft">The pilot</p>
      <h3>Tables, run by a designer on my team</h3>
    </div>
    <div class="cs-prose">
      <p>A third designer piloted the process on Tables, a rollout that had already stalled across the platform. It&rsquo;s the Table Migration card on the board above. Their plan audits every list view, makes a decision on each one, and shows a before and after for all but two.</p>
    </div>
    <CaseStudyFigure
      src={tablesPlanImg}
      alt="A wide Figma canvas. Along the top, four documents: the migration plan brief, a before-you-start checklist, an audit guide, and a decisions table. Below them, a row of seventeen pairs of screens, each a screenshot of a current table page above its redesign."
      caption="The pilot plan in Figma, built on the process template: brief, audit, and decisions along the top, then today&rsquo;s page and the proposed design for every remaining table."
    />
    <div class="cs-compare">
      <div>
        <p class="cs-compare-label">Before: today&rsquo;s Shipments list</p>
        <CaseStudyFigure
          src={tablesBeforeImg}
          alt="The current Shipments list: a full-width search field above the tabs, a row of ten filter dropdowns, and each shipment row drawn as its own bordered card."
        />
      </div>
      <div>
        <p class="cs-compare-label accent">After: the new Table pattern</p>
        <CaseStudyFigure
          src={tablesAfterImg}
          alt="The redesigned Shipments list: a compact search field, one filter bar holding all ten filters with Clear all and Save Filter, a count of results, a Customize table button, and rows separated by simple dividers."
        />
      </div>
    </div>
    <aside class="cs-outcome">
      <p class="eyebrow all-caps">Where it stands</p>
      <p>10 of 27 tables are on the new pattern. The other 17 each have a decision, a ticket, and a priority, ready for product to break down across their teams.</p>
    </aside>

    <div class="cs-run">
      <p class="eyebrow all-caps soft">My own run</p>
      <h3>Banners, which I audited and planned myself</h3>
    </div>
    <div class="cs-prose">
      <p>The Banner Message component was built once, but the move to every banner never officially happened. I documented the component in the library, then ran an AI-assisted audit of the code and the test environment. It&rsquo;s the Banner audit card on the board above. The audit found 61 places the product shows an important, non-blocking notice. 42 use the component, and all of them inherit two differences from the Figma spec. The other 19 are older alerts and hand-built boxes outside the system.</p>
      <p>My plan turns those 61 into 14 tickets, each with a priority. The first one fixes the shared component, which clears the inherited differences in all 42 at once.</p>
    </div>
    <CaseStudyFigure
      src={bannersAuditImg}
      alt="The top of the Banner Message audit. Summary tiles read 61 instances, 42 direct matches, 19 partial matches, 34 minor drift, 27 major drift, 0 exact match, and 24 variations. A panel compares the coded component with the Figma spec line by line: left padding and the dismiss default differ, everything else matches. A second panel lists the worst offenders, such as menus in the action slot, stacked banners, and older alert boxes."
      caption="My audit: every notice in the product, the shared component checked line by line against the Figma spec, and the worst local variations."
    />
    <div class="cs-compare">
      <div class="cs-panel cs-plan">
        <p class="cs-compare-label">From my plan: 14 tickets</p>
        <dl class="cs-facts rows">
          <div>
            <dt>P2</dt>
            <dd><b>First:</b> fix the shared component. One change corrects the spacing and the dismiss default everywhere it&rsquo;s used.</dd>
          </div>
          <div>
            <dt>P2</dt>
            <dd>Tracker settings: show one banner at a time and take the menu out of the action slot.</dd>
          </div>
          <div>
            <dt>P3 &times; 9</dt>
            <dd>Replace older alerts and hand-built boxes with the component, remove local overrides, and decide whether banners get a title.</dd>
          </div>
          <div>
            <dt>P4 &times; 3</dt>
            <dd>Low-traffic and admin screens, done when a team is already working in that area.</dd>
          </div>
        </dl>
      </div>
      <CaseStudyFigure
        src={bannersLibraryImg}
        alt="The Banner Message page in the component library, laid out as five panels: an overview with a change log, the component in its four tones, usage guidelines with do and don&rsquo;t examples, layout and spacing with redlines and behaviors, and three examples from the product."
        caption="The Banner Message page I wrote for the component library: when to use it, spacing, behaviors, and examples from the product."
      />
    </div>
    <aside class="cs-outcome">
      <p class="eyebrow all-caps">Where it stands</p>
      <p>The plan is in draft. All 14 tickets are written and prioritized, 11 with a proposed team, for product to claim or reassign.</p>
    </aside>
  </section>

  <!-- THE PEOPLE SIDE -->
  <section class="content-section" id="people">
    <p class="eyebrow all-caps soft">The people side</p>
    <h2 class="heading-3">A system only works if the designers grow with it.</h2>
    <div class="cs-cols">
      <div>
        <p class="eyebrow all-caps soft">Coaching</p>
        <h3>How I coach</h3>
        <p>Weekly 1:1s focused on systems-level, holistic solutions over granular pixel-pushing.</p>
      </div>
      <div>
        <p class="eyebrow all-caps soft">Team</p>
        <h3>Hiring and growth</h3>
        <p>I hired two versatile, senior designers and created individual growth frameworks and a design team leveling rubric.</p>
      </div>
    </div>
    <blockquote class="cs-quote">
      &ldquo;Design is finally involved in product roadmap discussions and it&rsquo;s a great thing!&rdquo;
      <cite>Senior product designer</cite>
    </blockquote>
  </section>

  <!-- ONE EXPERIMENT THAT FAILED -->
  <section class="content-section" id="failed">
    <p class="eyebrow all-caps soft">One experiment that failed</p>
    <h2 class="heading-3">Scaling also meant knowing when to remove process.</h2>
    <div class="cs-cols">
      <div>
        <p class="eyebrow all-caps soft">Experiment</p>
        <h3>Design Brief v1</h3>
        <p>A running artifact meant to preserve design goals and decisions throughout an initiative.</p>
      </div>
      <div>
        <p class="eyebrow all-caps soft">What happened</p>
        <ul class="cs-xlist">
          <li>Hard to maintain</li>
          <li>Poor discoverability</li>
          <li>Didn't solve a big enough problem</li>
          <li>Added process when it wasn't needed</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow all-caps soft">Decision</p>
        <span class="cs-stamp">No Go</span>
      </div>
      <div>
        <p class="eyebrow all-caps soft">Going Forward</p>
        <p>Closer PM-designer-EM collaboration and project-specific shared documents served us better.</p>
      </div>
    </div>
  </section>

  <!-- WHAT I LEARNED -->
  <section class="content-section" id="learned">
    <p class="eyebrow all-caps soft">What I learned</p>
    <h2 class="heading-3">The manager shouldn't be <i>the system.</i></h2>
    <div class="cs-prose">
      <p>Scaling a senior team isn't about getting better at keeping track of everything, everywhere. It's about building systems that <b>empower the team to do their most valuable work</b>. Clear ownership creates autonomy. Shared frameworks build consistency. AI reduces the cost of context.</p>
    </div>
  </section>

  <div class="content-section">
    <div class="cs-sign">
      <span>Brian Cleveland · Design leadership case study</span>
      <span>Internal details generalized for confidentiality</span>
    </div>
    <nav class="navigation-list" aria-label="More case studies">
      <ul>
        <li><ActionLink href={`${base}/#my-work`} label="Back to all work" /></li>
        <li><ActionLink href={`${base}/work/global-navigation`} label="Read: One navigation system, globally adopted" variant="filled" /></li>
      </ul>
    </nav>
  </div>
</CaseStudyLayout>

<style is:global>
  /*
    One "move": a short explanation and its result in a narrow column, with the
    real artifact taking most of the width. On small screens it stacks in source
    order: explanation, artifact, result.
  */
  .cs-move {
    display: grid;
    gap: var(--space-m);
  }

  @media screen and (min-width: 821px) {
    .cs-move {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-l);
      align-items: start;
    }

    .cs-move > .cs-prose {
      grid-area: 1 / 1;
    }

    .cs-move > .cs-figure {
      grid-area: 1 / 2 / -1 / 3;
    }

    .cs-move > .cs-outcome {
      grid-area: 2 / 1;
    }

    /* Two artifacts: the diagram sits under the text, beside the screenshot. */
    .cs-move.even {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr;
    }

    .cs-move.even > .cs-panel {
      grid-area: 2 / 1;
    }

    .cs-move.even > .cs-outcome {
      grid-area: 3 / 1;
    }
  }

  /* The result of a move: one bold line under a raspberry rule. */
  .cs-new .cs-outcome {
    display: grid;
    gap: var(--space-2xs);
    padding-top: var(--space-xs);
    border-top: 4px solid var(--accent);
  }

  .cs-new .cs-outcome .eyebrow {
    margin-bottom: 0;
    color: var(--accent-text);
  }

  .cs-new .cs-outcome p:not(.eyebrow) {
    font: var(--font-body-3);
    font-weight: 700;
    max-width: 44rem;
  }

  /* Figures in a pair sit on the same top edge, whatever their labels. */
  .cs-new .cs-run {
    display: grid;
    gap: var(--space-3xs);
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 2px solid var(--fg);
  }

  .cs-new .cs-run .eyebrow {
    margin-bottom: 0;
  }

  .cs-new .cs-run h3 {
    font: var(--font-body-3);
    font-weight: 700;
  }

  .cs-new .cs-plan {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .cs-new .cs-plan .cs-facts.rows > div {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-s);
  }

  .cs-new .cs-compare > div {
    display: grid;
    align-content: start;
  }
</style>
