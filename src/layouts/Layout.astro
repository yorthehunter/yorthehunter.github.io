---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/literata';

interface Props {
	title: string;
}

const { title } = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Product design manager with 16 years across enterprise platforms, design systems, and design engineering. Brian Cleveland leads product design at Tive." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	html.dark {
		/* --color-raspberry: #FF2D78; */
		--color-vibrant: #00856C;
		--color-vibrant-dark: #18F1CA;
		--color-primary: #ecf3f1;
		--color-secondary: #ceddd9;
		--color-bg: #1e2826;
		--color-bg-soften: #374340;
		--color-bg-overlay: rgba(191, 219, 211, 0.1);
		--color-vibrant-gradient: radial-gradient(100% 316.05% at 0% 100%, #004B48 0%, #0B7B67 50%, #149256 100%);
	}

	:root {
		--color-raspberry: #FF2D78;
		--color-vibrant: #18F1CA;
		--color-vibrant-dark: #00b594;
		--color-primary: #1e2826;
		--color-secondary: #374340;
		--color-bg: #ecf3f1;
		--color-bg-soften: #ceddd9;
		--color-bg-overlay: rgba(22,38,34,0.1);
		--color-bg-overlay-dark: rgba(22,38,34,0.8);
		--color-vibrant-gradient: radial-gradient(100% 316.05% at 0% 100%, #00CBC4 0%, #18F1CA 50%, #5BF4AB 100%);

		--font-family: 'Montserrat Variable', sans-serif;
		--secondary-font-family: 'Literata Variable', serif;
		--font-heading-weight: 500;
		--font-body-weight: 400;
		--font-size--1: clamp(0.8333rem, 0.7318rem + 0.5077vi, 1.1253rem);
		--font-size-0: clamp(1rem, 0.8261rem + 0.8696vi, 1.5rem);
		--font-size-1: clamp(1.2rem, 0.9219rem + 1.3904vi, 1.9995rem);
		--font-size-2: clamp(1.44rem, 1.0138rem + 2.131vi, 2.6653rem);
		--font-size-3: clamp(1.728rem, 1.0933rem + 3.1737vi, 3.5529rem);
		--font-size-4: clamp(2.0736rem, 1.1475rem + 4.6303vi, 4.736rem);

		/* Line-height by role, not by size step: display heads stay tight since
		   they're short and large; body copy stays a consistent, readable 1.5
		   regardless of which size step it borrows. */
		--line-height-display: 1.15;
		--line-height-heading: 1.3;
		--line-height-body: 1.5;

		--font-heading-1: var(--font-heading-weight) var(--font-size-4)/var(--line-height-display) var(--secondary-font-family);
		--font-heading-2: var(--font-heading-weight) var(--font-size-3)/var(--line-height-display) var(--secondary-font-family);
		--font-heading-3: var(--font-heading-weight) var(--font-size-2)/var(--line-height-heading) var(--secondary-font-family);
		--font-heading-4: var(--font-heading-weight) var(--font-size-1)/var(--line-height-heading) var(--font-family);
		--font-heading-5: var(--font-heading-weight) var(--font-size-0)/var(--line-height-heading) var(--font-family);
		--font-heading-6: var(--font-heading-weight) var(--font-size--1)/var(--line-height-heading) var(--font-family);
		--font-body-1: var(--font-body-weight) var(--font-size-2)/var(--line-height-body) var(--font-family);
		--font-body-2: var(--font-body-weight) var(--font-size-1)/var(--line-height-body) var(--font-family);
		--font-body-3: var(--font-body-weight) var(--font-size-0)/var(--line-height-body) var(--font-family);
		--font-body-4: var(--font-body-weight) var(--font-size--1)/var(--line-height-body) var(--font-family);

		--space-3xs: clamp(0.25rem, 0.2065rem + 0.2174vi, 0.375rem);
		--space-2xs: clamp(0.5rem, 0.413rem + 0.4348vi, 0.75rem);
		--space-xs: clamp(0.75rem, 0.6196rem + 0.6522vi, 1.125rem);
		--space-s: clamp(1rem, 0.8261rem + 0.8696vi, 1.5rem);
		--space-m: clamp(1.5rem, 1.2391rem + 1.3043vi, 2.25rem);
		--space-l: clamp(2rem, 1.6522rem + 1.7391vi, 3rem);
		--space-xl: clamp(3rem, 2.4783rem + 2.6087vi, 4.5rem);
		--space-2xl: clamp(4rem, 3.3043rem + 3.4783vi, 6rem);
		--space-3xl: clamp(6rem, 4.9565rem + 5.2174vi, 9rem);
	}
	* {
		margin: 0;
		padding: 0;
	}
	html {
		font-family: var(--font-family);
		font-size: 16px;
		background-color: var(--color-bg);
		transition: background-color 0.15s ease-out;
		scroll-behavior: smooth;
	}
	body {
		color: var(--color-primary);
	}

	a:link,
  a:visited {
    transition: color 0.15s;
    color: var(--color-vibrant-dark);
	}

  a:hover {
    color: inherit;
  }

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	.content-section {
		display: flex;
		padding: var(--space-xl) var(--space-s);
		flex-direction: column;
		align-items: stretch;
		justify-content: center;
		gap: 2.5rem;
		align-self: stretch;
		max-width: 70.5rem;
		margin: auto;
	}

	.heading-1 {
		font: var(--font-heading-1);
	}

	.heading-2 {
		font: var(--font-heading-2);
	}

	.heading-3 {
		font: var(--font-heading-3);
	}

	.heading-4 {
		font: var(--font-heading-4);
	}

	.body-1 {
		font: var(--font-body-1);
	}

	.body-2 {
		font: var(--font-body-2);
	}

	.body-3 {
		font: var(--font-body-3);
	}

	.body-4 {
		font: var(--font-body-4);
	}

	.navigation-list > ul {
		list-style: none;
		display: flex;
		flex-direction: row;
		gap: var(--space-2xs);
	}

	.navigation-list li {
		display: flex;
	}

	@media only screen and (max-width: 380px) {
		.navigation-list > ul {
			flex-direction: column;
		}
	}

	.all-caps {
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.soft {
		color: var(--color-secondary);
	}

	.eyebrow {
		font: var(--font-body-4);
		margin-bottom: -1.5rem;
	}

	.credibility-strip {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-2xs);
		row-gap: var(--space-3xs);
	}

	footer {
		border-top: 3px solid var(--color-vibrant);

		> p {
			padding: var(--space-xl) var(--space-s);
			max-width: 70.5rem;
			margin: auto;
			font: var(--font-body-4);
		}
	}
</style>
