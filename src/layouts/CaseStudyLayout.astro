---
import Layout from "./Layout.astro";
import TopNav from "../components/TopNav.astro";

interface Section {
  id: string;
  label: string;
}

interface Props {
  title: string;
  sections: Section[];
  /** Short label shown at the left of the sticky section nav. */
  navLabel: string;
}

const { title, sections, navLabel } = Astro.props;
---

<Layout title={title}>
  <TopNav />
  <nav class="cs-subnav" aria-label="Case study sections">
    <div class="cs-subnav-inner">
      <span class="cs-subnav-label">{navLabel}</span>
      <ol>
        {sections.map((s) => (
          <li><a href={`#${s.id}`} data-section={s.id}>{s.label}</a></li>
        ))}
      </ol>
    </div>
  </nav>
  <main id="main" class="case-study">
    <slot />
    <footer>
      <p>
        This site was built with <a
          href="https://github.com/yorthehunter/yorthehunter.github.io"
          target="_blank">Astro and SCSS</a
        >.
      </p>
    </footer>
  </main>
  <dialog class="cs-lightbox" id="cs-lightbox" aria-label="Enlarged image">
    <button type="button" class="cs-lightbox-close" aria-label="Close enlarged image">&times;</button>
    <div class="cs-lightbox-tabs" role="tablist" aria-label="Frames" hidden></div>
    <div class="cs-lightbox-pane">
      <img alt="" />
    </div>
    <p class="cs-lightbox-caption"></p>
  </dialog>
</Layout>

<script>
  // Lightbox: one shared <dialog>, filled from the clicked figure.
  const dialog = document.getElementById("cs-lightbox") as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector("img")!;
    const pane = dialog.querySelector<HTMLElement>(".cs-lightbox-pane")!;
    const tabs = dialog.querySelector<HTMLElement>(".cs-lightbox-tabs")!;
    const caption = dialog.querySelector<HTMLElement>(".cs-lightbox-caption")!;
    let opener: HTMLElement | null = null;

    type Frame = { label: string; src: string; alt: string };

    // Show one image. Tall "scroll" frames get a scrollable pane starting at the top.
    const show = (src: string, alt: string, scrolling: boolean) => {
      pane.classList.toggle("scrolling", scrolling);
      pane.scrollTop = 0;
      img.src = src;
      img.alt = alt;
    };

    const showFrames = (frames: Frame[]) => {
      tabs.replaceChildren();
      tabs.hidden = frames.length < 2;
      frames.forEach((f, i) => {
        const tab = document.createElement("button");
        tab.type = "button";
        tab.setAttribute("role", "tab");
        tab.textContent = f.label;
        tab.addEventListener("click", () => select(i));
        tabs.append(tab);
      });
      const select = (i: number) => {
        tabs.querySelectorAll("button").forEach((t, j) => {
          t.setAttribute("aria-selected", String(i === j));
          t.tabIndex = i === j ? 0 : -1;
        });
        show(frames[i].src, frames[i].alt, true);
      };
      select(0);
    };

    document.addEventListener("click", (e) => {
      const zoom = (e.target as Element).closest<HTMLElement>(".cs-zoom");
      if (!zoom) return;
      opener = zoom;
      caption.innerHTML = zoom.dataset.caption ?? ""; // authored in the repo, not user input
      caption.hidden = !zoom.dataset.caption;
      if (zoom.dataset.scroll) {
        showFrames(JSON.parse(zoom.dataset.scroll) as Frame[]);
      } else {
        tabs.hidden = true;
        show(zoom.dataset.full ?? "", zoom.dataset.alt ?? "", false);
      }
      dialog.showModal();
    });

    // Arrow keys move between frame tabs.
    tabs.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const all = Array.from(tabs.querySelectorAll<HTMLButtonElement>("button"));
      const i = all.findIndex((t) => t.getAttribute("aria-selected") === "true");
      const next = all[(i + (e.key === "ArrowRight" ? 1 : -1) + all.length) % all.length];
      next.click();
      next.focus();
    });

    // Click on the backdrop or the close button dismisses; clicks on the image don't.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || (e.target as Element).closest(".cs-lightbox-close")) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
      opener?.focus();
    });
  }
</script>

<script>
  // Highlight the section nav link for the section currently in view.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".cs-subnav a[data-section]"),
  );
  const byId = new Map(links.map((a) => [a.dataset.section!, a]));

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((a) => a.removeAttribute("aria-current"));
          byId.get(entry.target.id)?.setAttribute("aria-current", "true");
        });
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>

<!--
  Case-study primitives. Everything is built from the site tokens defined in
  Layout.astro (colors, type scale, spacing), so light/dark theming and fluid
  type come along for free. Class names are namespaced `cs-` so they can't
  collide with the rest of the site, and they extend (not replace) the global
  .content-section / .heading-* / .body-* classes.
-->
<style is:global>
  .cs-subnav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-bg-overlay);
    border-top: 1px solid var(--color-bg-overlay);
  }

  .cs-subnav-inner {
    max-width: 70.5rem;
    margin: auto;
    padding: 0 var(--space-s);
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: 3rem;
  }

  .cs-subnav-label {
    font: var(--font-heading-6);
    white-space: nowrap;
  }

  .cs-subnav ol {
    list-style: none;
    display: flex;
    gap: var(--space-3xs);
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cs-subnav ol::-webkit-scrollbar {
    display: none;
  }

  .cs-subnav a:link,
  .cs-subnav a:visited {
    display: block;
    font: var(--font-body-4);
    font-size: 0.8125rem;
    color: var(--color-secondary);
    text-decoration: none;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: 255px;
    white-space: nowrap;
    transition: color 0.15s, background-color 0.15s;
  }

  .cs-subnav a:hover {
    color: var(--color-primary);
    background-color: var(--color-bg-soften);
  }

  .cs-subnav a[aria-current="true"] {
    color: var(--color-primary);
    background-color: var(--color-vibrant);
  }

  @media screen and (max-width: 720px) {
    .cs-subnav-label {
      display: none;
    }
    .cs-subnav ol {
      margin-left: 0;
    }
  }

  .case-study section {
    scroll-margin-top: 3.5rem;
  }

  /* Reading column: long-form prose stays at a comfortable measure. */
  .cs-prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 44rem;
    font: var(--font-body-3);
  }

  .cs-prose ul,
  .cs-prose ol {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .cs-lede {
    font: var(--font-body-2);
    color: var(--color-secondary);
    max-width: 40rem;
  }

  .cs-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-l);
    align-items: start;
  }

  .cs-split.even {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media screen and (max-width: 820px) {
    .cs-split,
    .cs-split.even {
      grid-template-columns: 1fr;
    }
  }

  /* Hero stat strip */
  .cs-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 3px solid var(--color-vibrant);
  }

  .cs-stats li {
    padding: var(--space-s) var(--space-s) var(--space-s) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .cs-stats .value {
    font: var(--font-heading-weight) var(--font-size-3) / 1 var(--secondary-font-family);
    color: var(--color-vibrant-dark);
  }

  /* Word-valued stats and results (no number to show): step the size down so they fit. */
  .cs-stats .value.word,
  .cs-results .value.word {
    font-size: var(--font-size-2);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .cs-stats .label {
    font: var(--font-body-4);
    color: var(--color-secondary);
  }

  @media screen and (max-width: 820px) {
    .cs-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Key facts: label / value pairs */
  .cs-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-l);
  }

  .cs-facts dt {
    font: var(--font-body-4);
    color: var(--color-secondary);
    margin-bottom: var(--space-3xs);
  }

  .cs-facts dd {
    font: var(--font-body-3);
  }

  @media screen and (max-width: 820px) {
    .cs-facts {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }

  /* Before / after pair */
  .cs-compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    align-items: start;
  }

  .cs-compare-label {
    font: var(--font-body-4);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--space-2xs);
  }

  .cs-compare-label.accent {
    color: var(--color-primary);
  }

  .cs-compare .cs-figure.contain .cs-zoom {
    width: 100%;
  }

  .cs-compare .cs-figure.contain img {
    width: 100%;
    max-height: none;
  }

  @media screen and (max-width: 820px) {
    .cs-compare {
      grid-template-columns: 1fr;
    }
  }

  /* Numbered list of findings / steps */
  .cs-findings {
    list-style: none;
    counter-reset: finding;
    display: flex;
    flex-direction: column;
  }

  .cs-findings li {
    counter-increment: finding;
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-bg-overlay);
    font: var(--font-body-3);
  }

  .cs-findings li::before {
    content: counter(finding, decimal-leading-zero);
    font: var(--font-heading-weight) var(--font-size-1) / 1 var(--secondary-font-family);
    color: var(--color-vibrant-dark);
    opacity: 0.7;
    flex: 0 0 2.25rem;
  }

  /* Timeline */
  .cs-timeline {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-s);
    position: relative;
  }

  .cs-timeline li {
    position: relative;
    padding-top: var(--space-m);
    border-top: 3px solid var(--color-vibrant);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .cs-timeline li::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-vibrant-dark);
  }

  .cs-timeline .when {
    font: var(--font-body-4);
    color: var(--color-secondary);
  }

  .cs-timeline h3 {
    font: var(--font-heading-5);
  }

  .cs-timeline p {
    font: var(--font-body-4);
    color: var(--color-secondary);
  }

  @media screen and (max-width: 820px) {
    .cs-timeline {
      grid-template-columns: 1fr;
    }
  }

  /* Pill row (process steps, tags) */
  .cs-steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    counter-reset: step;
  }

  .cs-steps li {
    counter-increment: step;
    font: var(--font-body-4);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 255px;
    background: var(--color-bg-soften);
    display: flex;
    gap: var(--space-3xs);
  }

  .cs-steps li::before {
    content: counter(step);
    color: var(--color-vibrant-dark);
    font-weight: 600;
  }

  /* Decision card: the "why" behind a design choice */
  .cs-decision {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-m);
    border-radius: 20px;
    background: var(--color-bg-overlay);
  }

  .cs-decision-head {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }

  .cs-decision-head .index {
    font: var(--font-heading-2);
    color: var(--color-vibrant-dark);
    opacity: 0.6;
    line-height: 1;
  }

  .cs-decision-head h3 {
    font: var(--font-heading-3);
  }

  .cs-decision dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .cs-decision dt {
    font: var(--font-body-4);
    color: var(--color-secondary);
    margin-bottom: var(--space-3xs);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cs-decision dd {
    font: var(--font-body-3);
  }

  @media screen and (max-width: 820px) {
    .cs-decision dl {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }

  /* Callout: single sentence worth pausing on */
  .cs-callout {
    font: var(--font-heading-3);
    padding: var(--space-m) 0;
    border-top: 3px solid var(--color-vibrant);
    border-bottom: 1px solid var(--color-bg-overlay);
    max-width: 52rem;
  }

  .cs-callout em {
    font-style: normal;
    color: var(--color-vibrant-dark);
  }

  /* Table (design-vs-engineering tradeoffs, feedback channels) */
  .cs-table {
    width: 100%;
    border-collapse: collapse;
    font: var(--font-body-4);
  }

  .cs-table th,
  .cs-table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-xs) var(--space-s) var(--space-xs) 0;
    border-bottom: 1px solid var(--color-bg-overlay);
  }

  .cs-table th {
    font: var(--font-body-4);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 2px solid var(--color-primary);
  }

  .cs-table th[scope="row"] {
    color: var(--color-primary);
    text-transform: none;
    letter-spacing: 0;
    border-bottom: 1px solid var(--color-bg-overlay);
  }

  .cs-table-wrap {
    overflow-x: auto;
  }

  .cs-table-wrap .cs-table {
    min-width: 40rem;
  }

  /* Result cards: reuse the site's vibrant gradient */
  .cs-results {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
  }

  .cs-results li {
    background: var(--color-vibrant-gradient);
    color: white;
    border-radius: 20px;
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  html:not(.dark) .cs-results li {
    color: var(--color-primary);
  }

  .cs-results .value {
    font: var(--font-heading-weight) var(--font-size-3) / 1 var(--secondary-font-family);
  }

  .cs-results p {
    font: var(--font-body-4);
  }

  @media screen and (max-width: 820px) {
    .cs-results {
      grid-template-columns: 1fr;
    }
  }

  /* Evidence figures */
  .cs-figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
  }

  .cs-zoom {
    all: unset;
    display: block;
    cursor: zoom-in;
    border-radius: 12px;
    position: relative;
  }

  .cs-figure.contain .cs-zoom {
    margin: 0 auto;
    max-width: 100%;
    width: fit-content;
  }

  .cs-zoom:focus-visible {
    outline: 3px solid var(--color-vibrant-dark);
    outline-offset: 3px;
  }

  .cs-zoom::after {
    content: attr(data-hint);
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    font: var(--font-body-4);
    font-size: 0.8125rem;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 255px;
    background: var(--color-bg);
    color: var(--color-primary);
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }

  .cs-zoom:hover::after,
  .cs-zoom:focus-visible::after {
    opacity: 1;
  }

  .cs-figure img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-bg-overlay);
    display: block;
  }

  .cs-figure.contain img {
    width: auto;
    max-height: 32rem;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Lightbox */
  .cs-lightbox {
    border: 0;
    padding: var(--space-s);
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    color: white;
  }

  .cs-lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
  }

  .cs-lightbox::backdrop {
    background: rgba(10, 16, 14, 0.9);
  }

  .cs-lightbox-pane {
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .cs-lightbox img {
    max-width: min(100%, 120rem);
    max-height: calc(100vh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: white;
    cursor: default;
  }

  /* Tall frames that scroll in the source design: fit the width, scroll the height. */
  .cs-lightbox-pane.scrolling {
    width: min(100%, 80rem);
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 8px;
    background: white;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .cs-lightbox-pane.scrolling img {
    width: 100%;
    max-width: 100%;
    max-height: none;
    border-radius: 0;
  }

  .cs-lightbox-tabs {
    display: flex;
    gap: var(--space-3xs);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cs-lightbox-tabs[hidden] {
    display: none;
  }

  .cs-lightbox-tabs button {
    font: var(--font-body-4);
    border: 0;
    cursor: pointer;
    padding: var(--space-3xs) var(--space-s);
    border-radius: 255px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
  }

  .cs-lightbox-tabs button[aria-selected="true"] {
    background: var(--color-vibrant);
    color: var(--color-primary);
  }

  .cs-lightbox-tabs button:focus-visible {
    outline: 3px solid white;
    outline-offset: 2px;
  }

  .cs-lightbox-caption {
    font: var(--font-body-4);
    max-width: 52rem;
    text-align: center;
  }

  .cs-lightbox-close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
    background: var(--color-vibrant);
    color: var(--color-primary);
  }

  .cs-lightbox-close:hover {
    background: var(--color-bg);
  }

  .cs-lightbox-close:focus-visible {
    outline: 3px solid white;
    outline-offset: 2px;
  }

  .cs-figure figcaption {
    font: var(--font-body-4);
    color: var(--color-secondary);
    max-width: 52rem;
  }

  /* Key facts as full-width rows (label left, text right): use for longer values. */
  .cs-facts.rows {
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-bg-overlay);
  }

  .cs-facts.rows > div {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) minmax(0, 1fr);
    gap: var(--space-m);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-bg-overlay);
  }

  .cs-facts.rows dt {
    margin-bottom: 0;
  }

  .cs-facts.rows dd {
    max-width: 52rem;
  }

  @media screen and (max-width: 820px) {
    .cs-facts.rows > div {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }

  /* Result cards: small label above the value, evidence line below. */
  .cs-results .kicker {
    font: var(--font-body-4);
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .cs-results .proof {
    margin-top: auto;
    padding-top: var(--space-2xs);
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }

  /* Columns: label / heading / text, separated by a hairline. */
  .cs-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-m);
  }

  .cs-cols > * {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-content: start;
    padding-top: var(--space-xs);
    border-top: 2px solid var(--color-bg-overlay);
    color: inherit;
    text-decoration: none;
  }

  .cs-cols > a:link,
  .cs-cols > a:visited {
    color: inherit;
  }

  /* The global .eyebrow pulls up under its section gap; inside a container it sits normally. */
  .cs-cols .eyebrow,
  .cs-prose .eyebrow,
  .cs-decision-head .eyebrow,
  .cs-takeaway .eyebrow {
