---
import { areas as slides, areaAnchor } from "../data/expertise";
---

<div
  class="hero-rotator"
  role="group"
  aria-roledescription="carousel"
  aria-label="Areas of expertise"
>
  <div class="frame">
    <div class="stage">
      {slides.map((slide, i) => (
        <div
          class="slide"
          data-active={String(i === 0)}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
          aria-hidden={i === 0 ? "false" : "true"}
        >
          <p class="slide-title">
            <a href={areaAnchor(slide.id)}>{slide.title}</a>
          </p>
          <p class="slide-line">{slide.line}</p>
        </div>
      ))}
    </div>

    <button type="button" class="arrow prev" aria-label="Previous area of expertise">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M10 3 5 8l5 5"></path>
      </svg>
    </button>
    <button type="button" class="arrow next" aria-label="Next area of expertise">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m6 3 5 5-5 5"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const INTERVAL_MS = 5000;

  document.querySelectorAll<HTMLElement>(".hero-rotator").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".slide"));
    const prev = root.querySelector<HTMLButtonElement>(".prev")!;
    const next = root.querySelector<HTMLButtonElement>(".next")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let index = 0;
    let timer: number | undefined;
    let hovering = false;

    const show = (to: number) => {
      index = (to + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.dataset.active = String(active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    // A person who asks for less motion gets a still carousel they step through
    // with the arrows. Everyone else gets autoplay, paused while the pointer or
    // keyboard focus is inside it, or while the tab is hidden.
    const start = () => {
      stop();
      if (reduceMotion.matches || hovering || document.hidden) return;
      timer = window.setInterval(() => show(index + 1), INTERVAL_MS);
    };

    prev.addEventListener("click", () => {
      show(index - 1);
      start();
    });
    next.addEventListener("click", () => {
      show(index + 1);
      start();
    });

    root.addEventListener("pointerenter", () => {
      hovering = true;
      start();
    });
    root.addEventListener("pointerleave", () => {
      hovering = false;
      start();
    });
    root.addEventListener("focusin", () => {
      hovering = true;
      start();
    });
    root.addEventListener("focusout", () => {
      hovering = false;
      start();
    });
    document.addEventListener("visibilitychange", start);

    start();
  });
</script>

<style lang="scss">
  .hero-rotator {
    display: flex;
    flex-direction: column;
  }

  /* On phones and tablets there is no gutter to float the arrows in, so the
     text takes the full row and the arrows sit in a row beneath it. */
  .frame {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    max-width: 52rem;
  }

  /* Every slide shares one grid cell, so the stage is as tall as the tallest
     slide and nothing below it moves when the slides change. */
  .stage {
    display: grid;
    flex: 1 0 100%;
  }

  .slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.7s;

    &[data-active="true"] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }

  .slide-title {
    font: var(--font-heading-4);
    color: var(--color-vibrant-dark);
  }

  .slide-title a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .slide-line {
    font: var(--font-body-2);
    text-wrap: balance;
  }

  .arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-primary);
    background: transparent;
    border: 1px solid var(--color-vibrant-dark);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.15s;

    &:hover {
      background: var(--color-bg-overlay);
    }

    &:focus-visible {
      outline: 2px solid var(--color-vibrant-dark);
      outline-offset: 3px;
    }

    svg {
      width: 0.875rem;
      height: 0.875rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  /* Wide screens: float the arrows in the side gutters so the text stays
     aligned with the headline above it. The gutter is the page padding plus
     the margin outside the 70.5rem column, which is big enough from 76rem up. */
  @media screen and (min-width: 76rem) {
    .frame {
      position: relative;
      display: block;
    }

    /* Line the arrows up with the title row, so they sit in the same place
       whether the slide below it runs one line or two. */
    .arrow {
      position: absolute;
      top: calc(var(--font-size-1) * var(--line-height-heading) / 2);
      translate: 0 -50%;
    }

    .prev {
      right: calc(100% + var(--space-xs));
    }

    .next {
      left: calc(100% + var(--space-xs));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
      transform: none;
    }
  }
</style>
