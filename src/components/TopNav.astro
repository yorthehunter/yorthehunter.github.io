---
import { Image } from "astro:assets";
import LinkButton from './LinkButton.astro';
import brianCleveland from "../assets/images/brian-cleveland-headshot.png"; 
import ThemeIcon from './ThemeIcon.astro';

interface Props {
  /** Pin the bar to the top while scrolling. Off by default so pages with their own sticky bar don't stack two. */
  sticky?: boolean;
}

const { sticky = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class:list={["site-header", sticky && "sticky"]}>
<nav>
  <a href={`${base}/`} class="logo">
    <Image
      src={brianCleveland}
      alt="Brian Cleveland"
      class="image"
      loading="lazy"
    />
    <span>Brian Cleveland</span>
  </a>
  <ul>
    <li>
      <LinkButton href={`${base}/#my-work`} label="Work" />
    </li>
    <li>
      <LinkButton href={`${base}/#about-me`} label="About" />
    </li>
    <ThemeIcon />
  </ul>
</nav>
</header>

<style lang="scss">
  .site-header.sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-bg-overlay);
  }

  .logo {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: var(--space-2xs);

    @media screen and (max-width: 360px) {
      display: none;
    }

    .image {
      max-width: 56px;
      max-height: 56px;
    }

    span {
      font: var(--font-heading-6);
      font-size: clamp(0.8333rem, 0.7318rem + 0.5077vi, 1.3125rem);

      @media screen and (max-width: 520px) {
        display: none;
      }
    }
  }

  nav {
    padding: var(--space-2xs) var(--space-s);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin: auto;
    height: 3rem;

    ul {
      list-style-type: none;
      display: flex;
      flex-direction: row;
      gap: var(--space-2xs);
      height: 100%;
      align-items: center;

      li {
        // display: flex;
      }
    }  
  }
</style>
