---
import { Image } from "astro:assets";
import LinkButton from "../components/LinkButton.astro";
import modeDS from "../assets/images/sample-sf-mode.png";
import globalNavThumb from "../assets/images/sample-mh-global-nav-thumb.png";
import tiveLogo from "../assets/images/tive-logo.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const featuredStories = [
  {
    tags: ["Team leadership", "Operating model", "Enterprise platform"],
    title: "Leading and scaling product design at Tive",
    summary:
      "How I increased ownership across a senior design team while introducing stronger discovery, critique, validation, and shared product foundations.",
    proves: "I can inherit and lead a platform design team.",
    image: tiveLogo,
    alt: "Tive logo",
    fit: "contain",
    cta: {
      label: "Read the Case Study",
      href: `${base}/work/tive`,
      newWindow: false,
    },
  },
  {
    tags: ["Design systems", "Governance", "Design engineering"],
    title: "Scaling the Mode Design System at Stitch Fix",
    summary:
      "Helped grow adoption across 100+ product partners and 9 product teams through system architecture and design-engineering partnership.",
    proves: "I create organizational leverage, not just components.",
    image: modeDS,
    alt: "Collage of the Mode Design System library in Figma: the file browser with Foundational Notions, Kufak patterns, and Helper components, plus a card component spec and a design review thread.",
    cta: {
      label: "Read on Medium",
      href: "https://yorthehunter.medium.com/introducing-the-mode-design-system-b3a64cb916da?sk=7450450ef476290ea72991dc0c0110c8",
    },
  },
  {
    tags: ["Design systems", "Cross-platform", "Engineering partnership"],
    title: "One navigation system, globally adopted",
    summary:
      "Replaced seven different navigations with one configurable system across 5 web properties and 2 native apps, enabling global search and a 35% increase in navigation clickthroughs on the web home page.",
    proves: "I turn a single request into a platform capability.",
    image: globalNavThumb,
    alt: "Before and after: seven different navigation bars on the left, and one responsive navigation system on the right.",
    cta: {
      label: "Read the Case Study",
      href: `${base}/work/global-navigation`,
      newWindow: false,
    },
  },
];
---

<p>
  These are selected examples of the product and systems work that shaped how
  I lead today. They span design systems, platform architecture, product
  strategy, accessibility, and operational workflows—often at the
  intersection of design and engineering.
</p>

<div class="featured-stories">
  {featuredStories.map((story, i) => (
    <article class="story" data-reverse={i % 2 === 1}>
      <div class="story-media" data-contain={story.fit === "contain"}>
        <Image
          src={story.image}
          alt={story.alt ?? ""}
          class:list={["story-image", story.fit === "contain" && "contain"]}
          loading="lazy"
        />
        {story.cta && (
          // The CTA button below is the accessible link; this one is a mouse/touch
          // shortcut over the image, so it stays out of the tab order and screen readers.
          <a
            class="story-media-link"
            href={story.cta.href}
            target={story.cta.newWindow ?? true ? "_blank" : "_self"}
            rel={story.cta.newWindow ?? true ? "noopener noreferrer" : undefined}
            tabindex="-1"
            aria-hidden="true"
          >
            <span class="story-overlay">{story.cta.label}<span aria-hidden="true"> →</span></span>
          </a>
        )}
      </div>
      <div class="story-content">
        <div class="story-tags">
          {story.tags.map((tag) => (
            <span class="story-chip">{tag}</span>
          ))}
        </div>
        <h3>{story.title}</h3>
        <p class="story-summary">{story.summary}</p>
        <blockquote class="story-proves">{story.proves}</blockquote>
        {story.cta && (
          <LinkButton
            newWindow={story.cta.newWindow ?? true}
            label={story.cta.label}
            href={story.cta.href}
          />
        )}
      </div>
    </article>
  ))}
</div>

<style lang="scss">
  p {
    font: var(--font-body-3);
  }

  .featured-stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-m);
  }

  .story {
    display: flex;
    flex-direction: row;
    gap: var(--space-l);
    align-items: center;

    &[data-reverse="true"] {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 720px) {
      flex-direction: column;
    }
  }

  .story-media {
    flex: 0 0 45%;
    aspect-ratio: 3 / 2;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-bg-soften);
    position: relative;

    &[data-contain] {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-l);
      background: #fff;
    }
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    &.contain {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
  }

  .story-media-link {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    transition: background-color 0.15s ease-in;
    text-decoration: none;
    color: white;
  }

  .story-overlay {
    font: var(--font-heading-5);
    color: white;
    opacity: 0;
    transition: opacity 0.15s ease-in;
  }

  // Show the overlay on hover, or when the CTA button is focused by keyboard.
  .story-media-link:hover,
  .story:has(.story-content a:focus-visible) .story-media-link {
    background-color: var(--color-bg-overlay-dark);

    .story-overlay {
      opacity: 1;
    }
  }

  .story-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .story-chip {
    font: var(--font-body-4);
    background: var(--color-bg-soften);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 255px;
  }

  .story-content h3 {
    font: var(--font-heading-3);
  }

  .story-summary {
    font: var(--font-body-3);
  }

  .story-proves {
    font: var(--font-body-3);
    font-style: italic;
    border-left: 3px solid var(--color-vibrant);
    padding-left: var(--space-xs);
    margin: 0;
  }
</style>
