<p class="same">Same underlying object. Shared interaction and hierarchy rules. Different information density based on context.</p>
</details>

<script>
  // Level picker + anatomy highlight for the object-density demo.
  const ox = document.getElementById("ox");
  if (ox) {
    let level = 3;
    let anatomy = false;

    const draw = () => {
      ox.classList.toggle("anat-on", anatomy);
      document.getElementById("ox-anat")?.setAttribute("aria-pressed", String(anatomy));
      ox.querySelectorAll<HTMLButtonElement>(".ox-lv").forEach((b) => {
        const on = Number(b.dataset.lv) === level;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      });
      ox.querySelectorAll<HTMLElement>(".ox-stage").forEach((p) => {
        p.hidden = Number(p.dataset.panel) !== level;
      });
    };

    ox.addEventListener("click", (e) => {
      const target = e.target as Element;
      const tab = target.closest<HTMLElement>(".ox-lv");
      if (tab) {
        level = Number(tab.dataset.lv);
        draw();
      } else if (target.closest("#ox-anat")) {
        anatomy = !anatomy;
        draw();
      }
    });

    // Arrow keys move between levels.
    ox.addEventListener("keydown", (e) => {
      if (!(e.target as Element).closest(".ox-lv")) return;
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      level = Math.min(5, Math.max(1, level + (e.key === "ArrowRight" ? 1 : -1)));
      draw();
      ox.querySelector<HTMLElement>(`.ox-lv[data-lv="${level}"]`)?.focus();
    });

    draw();
  }
</script>

<style>
  /* Map the demo's local names onto the site tokens (light and dark follow html.dark). */
  details.more {
    --ink: var(--color-primary);
    --muted: var(--color-secondary);
    --ground: var(--color-bg);
    --line: color-mix(in srgb, var(--color-primary) 22%, transparent);
    --surface: color-mix(in srgb, var(--color-bg-soften) 40%, var(--color-bg));
    --sunk: var(--color-bg-soften);
    --accent-strong: var(--color-vibrant-dark);
    --accent-ink: color-mix(in srgb, var(--color-vibrant-dark) 55%, var(--color-primary));
    --accent-soft: color-mix(in srgb, var(--color-vibrant) 28%, var(--color-bg));
    --mono: var(--font-family);
    --display: var(--secondary-font-family);
    --body: var(--font-family);
  }

  details.more [hidden] { display: none !important; }

  .label {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .label.accent {
    color: var(--accent-ink);
  }

  .ox-cap h3 {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.2;
  }

  .ox-cap p,
  .same,
  .note {
    max-width: none;
  }
/* object explorer */
.ox{display:grid;gap:18px}
.ox-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.ox-toggle{font:inherit;font-family:var(--body);font-size:.8rem;font-weight:600;color:var(--ink);background:transparent;border:1px solid var(--line);border-radius:999px;padding:6px 12px 6px 8px;display:inline-flex;align-items:center;gap:8px;cursor:pointer}
.ox-toggle .sw{width:28px;height:16px;border-radius:999px;background:var(--sunk);position:relative;transition:background .15s}
.ox-toggle .sw::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:var(--surface);transition:transform .15s}
.ox-toggle[aria-pressed="true"] .sw{background:var(--accent-strong)}
.ox-toggle[aria-pressed="true"] .sw::after{transform:translateX(12px)}
.ox-toggle:focus-visible,.ox-lv:focus-visible{outline:2px solid var(--accent-strong);outline-offset:2px}
.ox-rail{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.ox-lv{font:inherit;text-align:left;background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:10px 12px;display:grid;gap:2px;cursor:pointer;transition:background .15s,border-color .15s}
.ox-lv:hover{background:var(--ground)}
.ox-lv[aria-selected="true"]{border-color:var(--accent-strong);background:var(--accent-soft)}
.ox-lv .slot-s{height:62px;display:flex;align-items:flex-end;margin-bottom:8px}
.sil{width:var(--w);height:var(--h);border:1.5px solid var(--muted);border-radius:3px;position:relative;background:var(--surface)}
.sil::before{content:"";position:absolute;left:2px;right:2px;top:2px;height:min(4px,calc(100% - 4px));border-radius:1px;background:var(--accent-strong)}
.ox-lv .n{font-family:var(--mono);font-size:.66rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-ink)}
.ox-lv .nm{font-family:var(--display);font-weight:600;font-size:1rem;line-height:1.2}
@media (max-width:700px){.ox-rail{grid-template-columns:repeat(5,minmax(96px,1fr));overflow-x:auto;padding-bottom:4px}}
.ox-stage{display:grid;grid-template-columns:minmax(0,250px) minmax(0,1fr);gap:28px;align-items:start}
.ox-stage.wide{grid-template-columns:1fr}
.ox-stage.wide .ox-cap{grid-template-columns:auto 1fr;column-gap:28px}
.ox-stage.wide .ox-cap h3{grid-column:1}.ox-stage.wide .ox-cap p{grid-column:2;grid-row:1/span 2}
@media (max-width:860px){.ox-stage,.ox-stage.wide .ox-cap{grid-template-columns:1fr}.ox-stage.wide .ox-cap p{grid-column:auto;grid-row:auto}}
.ox-cap{display:grid;gap:8px;align-content:start;padding-top:4px}
.ox-cap h3{font-size:1.35rem}
.ox-cap p{font-size:.95rem;color:var(--muted)}
.ox-foot .note{margin:0}

/* product UI, rebuilt from Figma — a fixed light "screen" in both themes */
.screen{--p-bg:#EEF0F3;--p-ink:#111827;--p-muted:#6B7280;--p-line:#E5E7EB;--p-blue:#1E5BF0;--p-blue-soft:#E8EFFE;--anat:#009C7E;
  background:var(--p-bg);border-radius:8px;padding:clamp(16px,3vw,32px);display:grid;place-items:center;min-height:340px;overflow-x:auto;color-scheme:light}
.p{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--p-ink);font-size:13px;line-height:1.4;letter-spacing:0;text-transform:none}
.p b{font-weight:600}
.p small{font-size:12px}
.p-card{background:#fff;border:1px solid var(--p-line);border-radius:8px}
.p-head{display:flex;align-items:center;gap:12px;min-width:0}
.p-ic{width:36px;height:36px;border-radius:8px;background:var(--p-blue-soft);color:var(--p-blue);display:grid;place-items:center;flex:none}
.p-ic svg{width:22px;height:22px}
.p-ic.lg{width:44px;height:44px}.p-ic.lg svg{width:28px;height:28px}
.p-t{min-width:0}.p-t b{display:block;font-size:13px}.p-t small{display:block;color:var(--p-muted)}
.p-t b.xl{font-size:22px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.p-x{margin-left:auto;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;color:var(--p-muted);background:#F3F4F6;font-size:14px;line-height:1}
.p-hr{border:0;height:1px;background:var(--p-line);margin:12px 0}
.p-okline{color:#15803D;font-weight:600;font-size:12px}
.p-link{color:var(--p-blue);font-weight:600;font-size:12px}
.p-chip{display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:999px;background:var(--p-blue-soft);color:var(--p-blue);border:1px solid #C9D8FD;font-weight:600;font-size:12px;white-space:nowrap}
.p-chip svg{width:14px;height:14px}
.p-chip.loc{background:#E6F6EF;color:#0F7A55;border-color:#BFE8D6}
.p-chip.loc::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.p-pill{display:inline-block;font-size:11px;font-weight:600;padding:2px 7px;border-radius:4px;white-space:nowrap}
.p-pill.ok{background:#DCFCE7;color:#166534}.p-pill.transit{background:#DBEAFE;color:#1E40AF}
.p-pill.carrier{background:var(--p-blue-soft);color:#1D4ED8}.p-pill.muted{background:#F3F4F6;color:#4B5563}
.p-btn-ic{width:28px;height:28px;border-radius:6px;display:grid;place-items:center;color:#374151;background:#F3F4F6;font-size:13px;flex:none}
.p-btn-ic.round{border-radius:50%}
.p-btn{font-size:12px;font-weight:600;padding:7px 12px;border-radius:6px;border:1px solid #D1D5DB;background:#fff;white-space:nowrap}
.p-btn.pri{background:var(--p-blue);color:#fff;border-color:var(--p-blue)}
.p-kv{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px}
.p-kv small{display:block;color:var(--p-muted);font-size:11px}
.p-kv span{display:block}
.p-kv .full,.full{grid-column:1/-1}
.p-tabs{display:flex;gap:18px;border-bottom:1px solid var(--p-line);color:var(--p-muted);font-size:12px;padding-inline:4px}
.p-tabs > *{padding-bottom:8px}
.p-tabs b{color:var(--p-blue);border-bottom:2px solid var(--p-blue);margin-bottom:-1px}
.p-rows{display:grid;gap:6px}
.p-row{display:flex;align-items:center;gap:8px;background:#F9FAFB;border:1px solid #F0F1F3;border-radius:6px;padding:7px 10px;font-size:12px}
.p-row .id{font-weight:600;margin-right:4px}
.p-row .route{margin-left:auto;color:var(--p-muted)}
.p-row .arr{color:var(--p-muted)}
.p-row .p-pill{margin-left:auto}
.p-row .route + .p-pill{margin-left:0}
.p-over{display:block;color:var(--p-muted);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin:14px 0 6px}
/* levels */
.lv1{display:grid;justify-items:center;gap:14px}
.p-tip{width:310px;padding:12px 14px;position:relative;box-shadow:0 10px 30px rgba(17,24,39,.14);display:grid;gap:8px}
