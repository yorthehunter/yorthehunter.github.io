---
const projects = [
  {
    title: "Creating an Accessible, Scalable Color Palette",
    summary:
      "Redesigned the color palette for all web and mobile platforms (member, provider, client) at Modern Health, enabling WCAG compliance at scale.",
    cta: "Read on Medium",
    href: "https://yorthehunter.medium.com/how-we-created-an-accessible-scalable-color-palette-2ae1242abdcb",
  },
  {
    title: "Launched a Personalized Home Screen",
    summary:
      "Designed a modular home screen at Modern Health, resulting in 25% higher retention and the launch of algorithmically personalized content.",
    cta: "View the Presentation",
    href: "https://www.figma.com/proto/wS6ueswXKU1mBg4spRq1C6/Portfolio-2023%E2%80%932024?page-id=808%3A11414&node-id=808-19544&node-type=section&t=vmCyw9LoND2kaYWq-0&scaling=min-zoom&content-scaling=fixed",
  },
  {
    title: "Designing a Returns Process That Reflects Reality",
    summary:
      "Redesigned warehouse returns at Stitch Fix around real-world operations, increasing throughput by 50% and reducing errors by 15%.",
    cta: "View the Presentation",
    href: "https://www.figma.com/proto/wS6ueswXKU1mBg4spRq1C6/Portfolio-2023%E2%80%932024?node-id=765-370&node-type=section&t=OCbnbU6f7Ta94OPS-1&scaling=contain&content-scaling=fixed&page-id=762%3A18068",
  },
];
---

<ul class="more-list">
  {projects.map((project) => (
    <li>
      <h4>{project.title}</h4>
      <p>{project.summary}</p>
      <a href={project.href} target="_blank" rel="noopener noreferrer">
        {project.cta} &rarr;
      </a>
    </li>
  ))}
</ul>

<style lang="scss">
  .more-list {
    list-style: none;
    border-top: 1px solid var(--color-bg-overlay);

    li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-l);
      row-gap: var(--space-3xs);
      padding: var(--space-s) 0;
      border-bottom: 1px solid var(--color-bg-overlay);

      @media screen and (max-width: 720px) {
        grid-template-columns: 1fr;
      }
    }

    h4 {
      font: var(--font-heading-4);
      grid-column: 1;
    }

    p {
      font: var(--font-body-3);
      color: var(--color-secondary);
      grid-column: 1;
      max-width: 60ch;
    }

    a {
      font: var(--font-body-4);
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      white-space: nowrap;

      @media screen and (max-width: 720px) {
        grid-column: 1;
        grid-row: auto;
        align-self: start;
        margin-top: var(--space-2xs);
      }
    }
  }
</style>
