---
// Sticky site header. Desktop: name on the left, tabs and theme toggle on the
// right. Below 54rem the tabs collapse into a menu opened by the hamburger.
interface Props {
  resumeUrl: string;
}

const { resumeUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  { label: "My Work", href: `${base}/#my-work`, external: false },
  { label: "About Me", href: `${base}/#contact`, external: false },
  { label: "My Resume", href: resumeUrl, external: true },
];

// The menu icon is the Figma asset, drawn through a mask so it follows the theme.
const iconVars = `--icon-menu:url(${base}/icons/dehaze.svg)`;
---

<header class="site-header" style={iconVars}>
  <div class="bar">
    <button
      class="icon-btn menu-btn"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="icon icon-menu" aria-hidden="true"></span>
    </button>
    <a class="name" href={`${base}/`}>Brian Cleveland</a>
    <nav class="menu" id="site-menu" aria-label="Primary" data-menu>
      <ul>
        {links.map((link) => (
          <li>
            <a
              class="tab"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      class="icon-btn theme-btn"
      type="button"
      aria-label="Dark mode"
      aria-pressed="false"
      data-theme-toggle
    >
      <svg class="theme-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path class="sun" fill-rule="evenodd" d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"></path>
        <path class="moon" fill-rule="evenodd" d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 4px solid var(--fg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
  }

  .name {
    flex: 1;
    min-width: 0;
    text-align: center;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-name);
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tab {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--fg);
    border-radius: 3px;
    color: var(--fg);
    font-weight: 700;
    font-size: var(--fs-body);
    letter-spacing: 1px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .tab:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .icon-btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 2px solid var(--fg);
    border-radius: 3px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .icon-btn:hover,
  .icon-btn[aria-expanded="true"] {
    background: var(--fg);
    color: var(--bg);
  }

  .icon {
    display: block;
    width: 20px;
    height: 20px;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .icon-menu {
    --icon: var(--icon-menu);
  }

  /* The existing sun and moon: sun in light mode, moon in dark mode. */
  .theme-icon {
    display: block;
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .moon {
    display: none;
  }

  :global(html.dark) .sun {
    display: none;
  }

  :global(html.dark) .moon {
    display: block;
  }

  /* Mobile: hamburger | name | theme, with the tabs in a dropdown. */
  @media (max-width: 53.99rem) {
    .menu {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      padding: var(--space-md);
      background: var(--bg);
      border-bottom: 4px solid var(--fg);
    }

    .menu:global(.is-open) {
      display: block;
    }

    .menu ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .tab {
      width: 100%;
    }
  }

  /* Desktop: 64px bar, 44px controls. */
  @media (min-width: 54rem) {
    .site-header {
      border-top: 4px solid var(--fg);
    }

    .bar {
      padding: 6px var(--space-md);
    }

    .menu-btn {
      display: none;
    }

    .name {
      flex: none;
      text-align: left;
      margin-right: auto;
    }

    .menu ul {
      display: flex;
      gap: var(--space-sm);
    }

    .icon-btn {
      width: 44px;
      height: 44px;
    }

    .icon {
      width: 24px;
      height: 24px;
    }

    .theme-icon {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const root = document.documentElement;

  if (header) {
    const menuBtn = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = header.querySelector<HTMLElement>("[data-menu]");
    const themeBtn = header.querySelector<HTMLButtonElement>("[data-theme-toggle]");

    const setMenu = (open: boolean) => {
      menu?.classList.toggle("is-open", open);
      menuBtn?.setAttribute("aria-expanded", String(open));
    };

    menuBtn?.addEventListener("click", () =>
      setMenu(menuBtn.getAttribute("aria-expanded") !== "true"),
    );
    menu?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setMenu(false);
    });
    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) setMenu(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuBtn?.getAttribute("aria-expanded") === "true") {
        setMenu(false);
        menuBtn.focus();
      }
    });

    const syncTheme = () =>
      themeBtn?.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    syncTheme();
    themeBtn?.addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {
        /* Storage can be blocked; the toggle still works for this visit. */
      }
      syncTheme();
    });
  }
</script>
