---
import { areas } from "../../data/expertise";
import SectionHeading from "./SectionHeading.astro";

interface Group {
  heading: string;
  items: string[];
}

interface Tab {
  id: string;
  label: string;
  groups: Group[];
}

const byId = (id: string) => areas.find((area) => area.id === id)?.groups ?? [];

// The first tab is the copy from the Figma design. The other three tabs have
// no content in the design yet, so they reuse the existing expertise data.
const tabs: Tab[] = [
  {
    id: "player-coach",
    label: "Player-Coach Leadership",
    groups: [
      {
        heading: "Growing a strong team",
        items: [
          "Managing senior designers",
          "Teaching systems thinking and mentoring others",
          "Setting individual growth plans and helping my team reach their goals",
        ],
      },
      {
        heading: "Leading small teams through rapid growth",
        items: [
          "Stitch Fix: first design hire, created and led the platform design team",
          "Tive: hired two designers, launched career ladders and growth plans",
          "Anomalie: Head of Design through a digital rebrand",
        ],
      },
      {
        heading: "Scaling enterprise products",
        items: [
          "Design processes that meet teams where they are",
          "Repeatable patterns for cross-platform designs and architecture",
        ],
      },
    ],
  },
  { id: "design-systems", label: "Design Systems", groups: byId("design-systems") },
  {
    id: "product-strategy",
    label: "Product Strategy",
    groups: byId("product-and-business-strategy"),
  },
  {
    id: "ai-design-engineering",
    label: "AI Design Engineering",
    groups: byId("design-engineering-with-ai"),
  },
];

// Three groups sit side by side on desktop; two or four read better as two columns.
const columns = (tab: Tab) => (tab.groups.length === 3 ? 3 : 2);
---

<section class="band" id="strengths">
  <div class="band-content">
    <SectionHeading
      title="Strengths"
      description="Serving startups, growth-phase Orgs, and Post-IPO companies in systems, leadership, and strategy"
    />
    <div class="strengths" data-tabs>
      <div class="tablist" role="tablist" aria-label="Strengths">
        {tabs.map((tab, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >{tab.label}</button>
        ))}
      </div>
      {tabs.map((tab, i) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          style={`--cols:${columns(tab)}`}
          hidden={i !== 0}
        >
          {tab.groups.map((group) => (
            <section class="highlight">
              <h3>{group.heading}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Strokes, group headers and the selected tab share these roles. Light mode
     is ink on cream; dark mode swaps in the raspberry so the near-white fill
     doesn't dominate. */
  .strengths {
    --edge: var(--fg);
    --head-bg: var(--fg);
    --head-fg: var(--bg);
    --selected-bg: var(--tab-active-bg);
    --selected-fg: var(--tab-active-fg);
  }

  :global(html.dark) .strengths {
    --edge: var(--accent);
    --head-bg: var(--accent);
    --head-fg: var(--on-accent);
    --selected-bg: var(--accent);
    --selected-fg: var(--on-accent);
  }

  .tablist {
    display: flex;
    gap: var(--space-xs);
    padding: 2px var(--space-sm) 0;
    border-bottom: 2px solid var(--edge);
    /* On narrow screens the four tabs scroll sideways instead of wrapping. */
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .tablist::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex: none;
    padding: var(--space-sm);
    border: 2px solid var(--edge);
    border-bottom: 0;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-body);
    line-height: 1.2;
    letter-spacing: 1px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .tab:hover {
    background: var(--subdued);
  }

  .tab[aria-selected="true"] {
    background: var(--selected-bg);
    color: var(--selected-fg);
  }

  .tab:focus-visible {
    outline-offset: -5px;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .panel[hidden] {
    display: none;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    padding: 1px;
    border: 2px solid var(--edge);
  }

  .highlight h3 {
    padding: var(--space-sm);
    background: var(--head-bg);
    color: var(--head-fg);
    font-weight: 700;
    font-size: var(--fs-body);
    line-height: 1.3;
  }

  .highlight ul {
    padding: var(--space-sm) var(--space-sm) var(--space-sm) calc(var(--space-sm) + 27px);
    list-style: disc;
  }

  .highlight li + li {
    margin-top: var(--space-sm);
  }

  @media (min-width: 54rem) {
    .panel {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls") ?? ""));

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i]!.hidden = !on;
      });
      tabs[index].scrollIntoView({ block: "nearest", inline: "nearest" });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : event.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : null;
        if (next !== null) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  });
</script>
