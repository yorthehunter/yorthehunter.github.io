---
import { areas } from "../../data/expertise";
import SectionHeading from "./SectionHeading.astro";

interface Group {
  heading: string;
  items: string[];
}

interface Tab {
  id: string;
  /** Matching id in the expertise data, which supplies the one-line summary. */
  area: string;
  label: string;
  groups: Group[];
}

const area = (id: string) => areas.find((a) => a.id === id);
const byId = (id: string) => area(id)?.groups ?? [];

// The first tab is the copy from the Figma design. The other three tabs have
// no content in the design yet, so they reuse the existing expertise data.
const tabs: Tab[] = [
  {
    id: "player-coach",
    area: "player-coach-leadership",
    label: "Player-Coach Leadership",
    groups: [
      {
        heading: "Growing a strong team",
        items: [
          "Managing senior designers",
          "Teaching systems thinking and mentoring others",
          "Setting individual growth plans and helping my team reach their goals",
        ],
      },
      {
        heading: "Leading small teams through rapid growth",
        items: [
          "Stitch Fix: first design hire, created and led the platform design team",
          "Tive: hired two designers, launched career ladders and growth plans",
          "Anomalie: Head of Design through a digital rebrand",
        ],
      },
      {
        heading: "Scaling enterprise products",
        items: [
          "Design processes that meet teams where they are",
          "Repeatable patterns for cross-platform designs and architecture",
        ],
      },
    ],
  },
  {
    id: "design-systems",
    area: "design-systems",
    label: "Design Systems",
    groups: byId("design-systems"),
  },
  {
    id: "product-strategy",
    area: "product-and-business-strategy",
    label: "Product Strategy",
    groups: byId("product-and-business-strategy"),
  },
  {
    id: "ai-design-engineering",
    area: "design-engineering-with-ai",
    label: "AI Design Engineering",
    groups: byId("design-engineering-with-ai"),
  },
];

// Three groups sit side by side on desktop; two or four read better as two columns.
const columns = (tab: Tab) => (tab.groups.length === 3 ? 3 : 2);
---

<section class="band" id="strengths">
  <div class="band-content">
    <SectionHeading
      title="Strengths"
      description="Serving startups, growth-phase Orgs, and Post-IPO companies in systems, leadership, and strategy"
    />
    <div class="strengths" data-tabs>
      <div class="picker" role="tablist" aria-label="Four strengths">
        {tabs.map((tab, i) => (
          <button
            class="pick"
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            style={`--i:${i}`}
          >
            <span class="name">{tab.label}</span>
            <span class="mark" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      {tabs.map((tab, i) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          style={`--i:${i};--cols:${columns(tab)}`}
          hidden={i !== 0}
        >
          <p class="lead">{area(tab.area)?.line}</p>
          <div class="groups">
            {tab.groups.map((group) => (
              <section class="highlight">
                <h3>{group.heading}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Strokes, group headers and the selected tab share these roles. Light mode
     is ink on cream; dark mode swaps in the raspberry so the near-white fill
     doesn't dominate. */
  .strengths {
    --edge: var(--fg);
    --head-bg: var(--fg);
    --head-fg: var(--bg);
    --selected-bg: var(--tab-active-bg);
    --selected-fg: var(--tab-active-fg);
  }

  :global(html.dark) .strengths {
    --edge: var(--accent);
    --head-bg: var(--accent);
    --head-fg: var(--on-accent);
    --selected-bg: var(--accent);
    --selected-fg: var(--on-accent);
  }

  /* Phones: an accordion. The four buttons stack, and the open strength's
     panel sits directly under its own button. The buttons stay one tablist
     in the markup; `display: contents` and `order` interleave the panels. */
  .strengths {
    display: flex;
    flex-direction: column;
  }

  .picker {
    display: contents;
  }

  .pick {
    order: calc(var(--i) * 2);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--edge);
    border-radius: 3px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-body);
    line-height: 1.2;
    letter-spacing: 1px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .pick + .pick {
    margin-top: var(--space-sm);
  }

  .pick:hover {
    background: var(--subdued);
  }

  .pick[aria-selected="true"] {
    background: var(--selected-bg);
    color: var(--selected-fg);
  }

  .mark {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--fs-mono);
  }

  .mark {
    margin-left: auto;
  }

  .mark::before {
    content: "+";
  }

  .pick[aria-selected="true"] .mark::before {
    content: "\2212";
  }

  .panel {
    order: calc(var(--i) * 2 + 1);
    margin-block: var(--space-sm);
  }

  .panel[hidden] {
    display: none;
  }

  /* The strength's one-line claim, above the detail that backs it up. */
  .lead {
    margin-bottom: var(--space-md);
    font-weight: 700;
    font-size: var(--fs-heading);
    line-height: 1.2;
    text-wrap: balance;
  }

  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    padding: 1px;
    border: 2px solid var(--edge);
  }

  .highlight h3 {
    padding: var(--space-sm);
    background: var(--head-bg);
    color: var(--head-fg);
    font-weight: 700;
    font-size: var(--fs-body);
    line-height: 1.3;
  }

  .highlight ul {
    padding: var(--space-sm) var(--space-sm) var(--space-sm) calc(var(--space-sm) + 27px);
    list-style: disc;
  }

  .highlight li + li {
    margin-top: var(--space-sm);
  }

  /* Wider screens: the buttons sit in a row above one shared panel, and wrap
     onto a second row instead of scrolling sideways. */
  @media (min-width: 40rem) {
    .picker {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin-bottom: var(--space-lg);
    }

    .pick,
    .panel {
      order: 0;
    }

    .pick + .pick {
      margin-top: 0;
    }

    .panel {
      margin-block: 0;
    }

    .mark {
      display: none;
    }
  }

  @media (min-width: 54rem) {
    .groups {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls") ?? ""));

    const select = (index: number, focus = false) => {
      // In the stacked layout a panel closing above the pressed button moves
      // it. Measure before and after, and scroll by the difference so the
      // button stays where it was pressed.
      const before = tabs[index].getBoundingClientRect().top;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i]!.hidden = !on;
      });
      const shift = tabs[index].getBoundingClientRect().top - before;
      if (shift) window.scrollBy({ top: shift, behavior: "instant" });
      if (focus) tabs[index].focus({ preventScroll: true });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" || event.key === "ArrowDown" ? (i === last ? 0 : i + 1)
          : event.key === "ArrowLeft" || event.key === "ArrowUp" ? (i === 0 ? last : i - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : null;
        if (next !== null) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  });
</script>
